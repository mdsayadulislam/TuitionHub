# Application Configuration
NODE_ENV=development
PORT=3000

# Database
# SQLite is used locally, no connection string needed.

# SQL Server Express 2022 Configuration
# Make sure your SQL Server allows remote connections and you use the correct port (default 1433)
SQL_SERVER_USER=
SQL_SERVER_PASSWORD=
SQL_SERVER_HOST=
SQL_SERVER_DATABASE=
SQL_SERVER_ENCRYPT=true
